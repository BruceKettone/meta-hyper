 mm/memory.c   |  9 +--------
 mm/rmap.c     |  7 +------
 3 files changed, 12 insertions(+), 14 deletions(-)

diff --git a/mm/internal.h b/mm/internal.h
index 430aa72a45758..0360648e5726a 100644
--- a/mm/internal.h
+++ b/mm/internal.h
@@ -1955,4 +1955,14 @@ static inline int get_sysctl_max_map_count(void)
