diff --git a/mm/page_owner.c b/mm/page_owner.c
index 2dddcb6510aa1..342549891a8d4 100644
--- a/mm/page_owner.c
+++ b/mm/page_owner.c
@@ -422,6 +422,29 @@ void __folio_copy_owner(struct folio *newfolio, struct folio *old)
