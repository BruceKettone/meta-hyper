 	return 0;
 }
@@ -927,12 +947,17 @@ static ssize_t page_owner_write(struct file *file,
 	int ret;
 	struct page_owner_filter_state *state = file->private_data;
 	enum page_owner_print_mode new_print_mode;
+	nodemask_t new_nid_filter;
