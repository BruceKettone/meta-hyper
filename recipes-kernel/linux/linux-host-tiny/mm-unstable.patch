 1 file changed, 27 insertions(+), 16 deletions(-)

diff --git a/mm/vmscan.c b/mm/vmscan.c
index 89ee818e704f7..26df81e773ffb 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -841,10 +841,16 @@ enum folio_references {
