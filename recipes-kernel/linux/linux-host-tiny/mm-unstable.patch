--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1252,6 +1252,7 @@ config ZONE_DEVICE
 config HMM_MIRROR
 	bool
 	depends on MMU
+	select MMU_NOTIFIER
 
 config GET_FREE_REGION
 	bool
